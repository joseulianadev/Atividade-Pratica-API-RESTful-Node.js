{
  "info": {
    "_postman_id": "a7f3c9d2-4b81-4e6a-9c05-1f2e3d4a5b60",
    "name": "API Produtos",
    "description": "Plano de testes da API de Produtos.\n\nAntes de executar, ajuste a variavel \"baseUrl\" na aba Variables da colecao com a URL da API no Render.\n\nAs requisicoes devem ser executadas na ordem, pois a de numero 04 guarda o id do produto criado na variavel \"novoProdutoId\", usada pelas requisicoes 05, 06, 07, 09 e 10.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Consultar todos os produtos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta deve ser um array\", function () {",
              "    const dados = pm.response.json();",
              "    pm.expect(dados).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Consultar um produto existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Produto deve possuir os atributos esperados\", function () {",
              "    const produto = pm.response.json();",
              "    pm.expect(produto).to.have.property(\"id\");",
              "    pm.expect(produto).to.have.property(\"descricao\");",
              "    pm.expect(produto).to.have.property(\"preco\");",
              "    pm.expect(produto).to.have.property(\"categoria\");",
              "    pm.expect(produto).to.have.property(\"estoque\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "1"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Consultar um produto inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "9999"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 - Cadastrar um novo produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Produto deve possuir os atributos esperados\", function () {",
              "    const produto = pm.response.json();",
              "    pm.expect(produto).to.have.property(\"id\");",
              "    pm.expect(produto).to.have.property(\"descricao\");",
              "    pm.expect(produto).to.have.property(\"preco\");",
              "    pm.expect(produto).to.have.property(\"categoria\");",
              "    pm.expect(produto).to.have.property(\"estoque\");",
              "});",
              "",
              "// Guarda o id do produto criado para as proximas requisicoes.",
              "pm.collectionVariables.set(\"novoProdutoId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Monitor 24 polegadas\",\n  \"preco\": 899.9,\n  \"categoria\": \"Monitores\",\n  \"estoque\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "05 - Consultar o produto recem-cadastrado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Deve retornar o produto cadastrado\", function () {",
              "    const produto = pm.response.json();",
              "    pm.expect(produto.descricao).to.eql(\"Monitor 24 polegadas\");",
              "    pm.expect(produto.preco).to.eql(899.9);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{novoProdutoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{novoProdutoId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 - Alterar um produto existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta deve conter os dados alterados\", function () {",
              "    const produto = pm.response.json();",
              "    pm.expect(produto.descricao).to.eql(\"Monitor LED 24 polegadas\");",
              "    pm.expect(produto.preco).to.eql(849.9);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{novoProdutoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{novoProdutoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Monitor LED 24 polegadas\",\n  \"preco\": 849.9,\n  \"categoria\": \"Monitores\",\n  \"estoque\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "07 - Verificar se a alteracao foi realizada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Dados devem estar atualizados\", function () {",
              "    const produto = pm.response.json();",
              "    pm.expect(produto.descricao).to.eql(\"Monitor LED 24 polegadas\");",
              "    pm.expect(produto.preco).to.eql(849.9);",
              "    pm.expect(produto.estoque).to.eql(12);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{novoProdutoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{novoProdutoId}}"
          ]
        }
      },
      "response": []
    },
